<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ntd1hc.tmlselftest">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TML-selftest"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name="com.example.ntd1hc.tmlselftest.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.ntd1hc.tmlselftest.ListviewActivity" />
        <activity android:name="com.example.ntd1hc.tmlselftest.RegisterActivity"></activity>
    </application>

</manifest>